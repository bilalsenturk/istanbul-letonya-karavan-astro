---
import { Picture } from 'astro:assets';
import heroImage from '../assets/journey/kuzey-road-motion.webp';
import RouteMap from './RouteMap.astro';

interface Stop {
  name: string;
  lat: number;
  lng: number;
}

interface Props {
  routeStops: Stop[];
  totalKm: number;
}

const { routeStops, totalKm } = Astro.props;
---

<div class="journey-opening">
  <section
    class="journey-hero"
    aria-label="Leyla'nın Kuzey Yolculuğu"
    data-journey-hero
    data-stops={JSON.stringify(routeStops)}
  >
    <div class="journey-hero__frame">
      <div class="journey-hero__visual">
        <Picture
          class="journey-hero__image"
          src={heroImage}
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 760px) 58vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          alt="Günün ilk ışıklarında kuzeye ilerleyen otomobil ve Adria karavan"
          priority
        />
        <div class="journey-hero__edge" aria-hidden="true"></div>
        <section class="journey-countdown" role="timer" aria-live="off" aria-label="Kalkış durumu">
          <span id="hero-countdown-label">Kalkışa</span>
          <div>
            <strong><b id="countdown-days">--</b> gün</strong>
            <small>
              <span id="countdown-hours">--</span>:<span id="countdown-minutes">--</span>:<span id="countdown-seconds">--</span>
            </small>
          </div>
        </section>
      </div>

      <div class="journey-hero__copy">
        <h1>Leyla'nın<br />Kuzey Yolculuğu</h1>

        <div class="journey-live" aria-live="polite">
          <span class="journey-live__dot" id="live-dot" aria-hidden="true"></span>
          <span class="journey-live__copy">
            <small>Şu an</small>
            <strong id="live-city">Konum güncelleniyor</strong>
            <span>
              <b id="hero-live-text">Kalkış hazırlığı</b>
              <time id="live-updated">Bekleniyor</time>
            </span>
          </span>
        </div>

        <div class="journey-route" aria-label="Rota özeti">
          <span class="journey-route__rail" aria-hidden="true"><span id="hero-route-fill"></span></span>
          <ol>
            <li data-hero-role="start"><i aria-hidden="true"></i><small>İstanbul</small></li>
            <li data-hero-role="current"><i aria-hidden="true"></i><small id="hero-current-place">Şu an</small></li>
            <li data-hero-role="next"><i aria-hidden="true"></i><small id="hero-next-place">Sofya</small></li>
            <li data-hero-role="end"><i aria-hidden="true"></i><small>Riga</small></li>
          </ol>
        </div>
        <p id="hero-route-status" class="sr-only" role="status" aria-live="polite">Rota başlamadı.</p>
      </div>

      <div class="journey-hero__map">
        <RouteMap
          title="Canlı rota"
          routeStops={routeStops}
          activeFrom="İstanbul"
          activeTo="Riga"
          mode="journey"
          live={true}
          height="180px"
          variant="hero"
        />
      </div>
    </div>
  </section>

  <section class="journey-summary" aria-label="Canlı yolculuk özeti">
    <div class="journey-summary__track">
      <article class="journey-summary__item">
        <span>Kalan yol</span>
        <strong id="remaining-distance">-</strong>
        <small id="remaining-note">Planlanan rota</small>
      </article>
      <article class="journey-summary__item">
        <span>Gidilen</span>
        <strong id="live-traveled">-</strong>
        <small id="journey-progress-note">Rota başlamadı</small>
      </article>
      <article class="journey-summary__item">
        <span>Hava</span>
        <strong id="weather-now">-</strong>
        <small id="weather-detail">Bekleniyor</small>
      </article>
      <article class="journey-summary__item">
        <span>Yakıt</span>
        <strong id="fuel-used">-</strong>
        <small id="fuel-note">Bekleniyor</small>
      </article>
      <article class="journey-summary__item">
        <span>Harcanan</span>
        <strong id="spend-amount">-</strong>
        <small id="spend-note">Bekleniyor</small>
      </article>
    </div>

    <div
      class="journey-summary__progress"
      role="progressbar"
      aria-label="Toplam rota ilerlemesi"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span>İstanbul → Riga</span>
      <div><i id="journey-progress"></i></div>
      <strong>{totalKm.toLocaleString('tr-TR')} km</strong>
    </div>
  </section>
</div>

<script>
  import { initJourneyHero } from '../scripts/journeyExperience';

  document.querySelectorAll<HTMLElement>('[data-journey-hero]').forEach((root) => {
    initJourneyHero(root);
  });
</script>

<style>
  .journey-opening {
    --journey-bg: #080b0f;
    --journey-surface: #10151b;
    --journey-surface-2: #141a21;
    --journey-line: rgba(255, 255, 255, 0.12);
    --journey-text: #f7f8f9;
    --journey-muted: #929aa5;
    --journey-road: #ff9b50;
    --journey-live: #58e69a;
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    color: var(--journey-text);
    background: var(--journey-bg);
  }

  .journey-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background:
      radial-gradient(circle at 78% 8%, rgba(255, 155, 80, 0.08), transparent 28%),
      var(--journey-bg);
  }

  .journey-hero__frame {
    display: grid;
    grid-template-areas:
      "visual"
      "copy"
      "map";
    width: 100%;
    margin: 0 auto;
  }

  .journey-hero__visual {
    position: relative;
    grid-area: visual;
    height: clamp(320px, 44svh, 430px);
    overflow: hidden;
    background: #14181d;
  }

  .journey-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48% center;
    transform: scale(1.045) translate3d(-1.5%, 0, 0);
    animation: journey-image-drift 12s ease-in-out infinite alternate;
    will-change: transform;
  }

  .journey-hero__edge {
    position: absolute;
    inset: auto 0 0;
    height: 34%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, var(--journey-bg));
  }

  .journey-countdown {
    position: absolute;
    z-index: 2;
    top: 14px;
    right: 14px;
    display: grid;
    gap: 4px;
    min-width: 144px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    color: #fff;
    background: rgba(6, 10, 14, 0.76);
    box-shadow: 0 18px 42px -26px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .journey-countdown > span {
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journey-countdown > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .journey-countdown strong,
  .journey-countdown small {
    font-variant-numeric: tabular-nums;
  }

  .journey-countdown strong {
    color: #fff;
    font-size: 0.92rem;
    font-weight: 760;
  }

  .journey-countdown strong b {
    color: #ffbd84;
    font-family: var(--font-display);
    font-size: 1.48rem;
    line-height: 1;
  }

  .journey-countdown small {
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .journey-hero__copy {
    grid-area: copy;
    padding: 4px 18px 24px;
  }

  .journey-hero h1 {
    max-width: 560px;
    margin: 0;
    color: #fff;
    font-size: clamp(2.55rem, 12vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.052em;
    line-height: 0.9;
  }

  .journey-live {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 20px;
    padding: 13px 14px;
    border: 1px solid var(--journey-line);
    border-radius: 13px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018));
  }

  .journey-live__dot {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--journey-live);
    box-shadow: 0 0 0 6px rgba(88, 230, 154, 0.14);
    animation: journey-live-pulse 1.8s ease-out infinite;
  }

  .journey-live__dot.is-paused {
    background: var(--journey-road);
    box-shadow: 0 0 0 6px rgba(255, 155, 80, 0.14);
    animation: none;
  }

  .journey-live__copy {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  .journey-live__copy > small {
    color: var(--journey-muted);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journey-live__copy > strong {
    overflow-wrap: anywhere;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .journey-live__copy > span {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 9px;
    color: var(--journey-muted);
    font-size: 0.72rem;
  }

  .journey-live__copy b {
    color: #c6ccd3;
    font-weight: 650;
  }

  .journey-route {
    position: relative;
    margin-top: 22px;
  }

  .journey-route__rail {
    position: absolute;
    top: 7px;
    left: 8px;
    right: 8px;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
  }

  .journey-route__rail > span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: repeating-linear-gradient(90deg, var(--journey-road) 0 18px, #ffd1ad 18px 27px);
    background-size: 54px 100%;
    animation: journey-route-flow 1.4s linear infinite;
    transition: width 500ms ease;
  }

  .journey-route ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-route li {
    display: grid;
    min-width: 0;
    justify-items: center;
    gap: 7px;
    color: #858e99;
    text-align: center;
  }

  .journey-route li:first-child {
    justify-items: start;
    text-align: left;
  }

  .journey-route li:last-child {
    justify-items: end;
    text-align: right;
  }

  .journey-route i {
    width: 16px;
    height: 16px;
    border: 2px solid #69727c;
    border-radius: 999px;
    background: var(--journey-bg);
    box-shadow: 0 0 0 4px var(--journey-bg);
  }

  .journey-route small {
    max-width: 72px;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.65rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .journey-route li.is-passed,
  .journey-route li.is-active,
  .journey-route li.is-next {
    color: #e7ebee;
  }

  .journey-route li.is-passed i {
    border-color: var(--journey-road);
    background: var(--journey-road);
  }

  .journey-route li.is-active i {
    border-color: var(--journey-live);
    background: var(--journey-live);
    box-shadow: 0 0 0 5px rgba(88, 230, 154, 0.18);
  }

  .journey-route li.is-next i {
    border-color: #d8dee4;
  }

  .journey-hero__map {
    position: relative;
    z-index: 2;
    grid-area: map;
    min-height: 180px;
    margin: 0 12px 18px;
  }

  .journey-summary {
    padding: 0 12px 26px;
    background: var(--journey-bg);
  }

  .journey-summary__track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .journey-summary__track::-webkit-scrollbar {
    display: none;
  }

  .journey-summary__item {
    display: grid;
    flex: 0 0 68vw;
    min-height: 118px;
    align-content: space-between;
    gap: 8px;
    margin: 0;
    padding: 15px;
    scroll-snap-align: start;
    border: 1px solid var(--journey-line);
    border-radius: 13px;
    background: var(--journey-surface);
  }

  .journey-summary__item > span {
    color: var(--journey-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journey-summary__item strong {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1;
  }

  .journey-summary__item small {
    color: var(--journey-muted);
    font-size: 0.72rem;
  }

  .journey-summary__progress {
    display: grid;
    grid-template-columns: auto minmax(80px, 1fr) auto;
    gap: 12px;
    align-items: center;
    margin-top: 12px;
    color: var(--journey-muted);
    font-size: 0.7rem;
  }

  .journey-summary__progress > div {
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
  }

  .journey-summary__progress i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--journey-road);
    transition: width 500ms ease;
  }

  .journey-summary__progress strong {
    color: #d8dde2;
    font-size: 0.72rem;
  }

  @keyframes journey-image-drift {
    from { transform: scale(1.045) translate3d(-1.5%, 0, 0); }
    to { transform: scale(1.075) translate3d(0.8%, -0.3%, 0); }
  }

  @keyframes journey-route-flow {
    to { background-position: 54px 0; }
  }

  @keyframes journey-live-pulse {
    0%, 46% { box-shadow: 0 0 0 6px rgba(88, 230, 154, 0.14); }
    72%, 100% { box-shadow: 0 0 0 12px rgba(88, 230, 154, 0); }
  }

  @media (min-width: 760px) {
    .journey-hero {
      padding: 28px 0 20px;
    }

    .journey-hero__frame {
      grid-template-columns: minmax(330px, 0.76fr) minmax(520px, 1.24fr);
      grid-template-rows: 420px 200px;
      grid-template-areas:
        "copy visual"
        "copy map";
      width: min(1280px, 94vw);
      gap: 0 20px;
    }

    .journey-hero__visual {
      height: 420px;
      border: 1px solid var(--journey-line);
      border-radius: 18px 18px 0 0;
    }

    .journey-hero__image {
      object-position: center;
    }

    .journey-hero__edge {
      height: 20%;
      background: linear-gradient(180deg, transparent, rgba(8, 11, 15, 0.5));
    }

    .journey-hero__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 36px 26px 36px 4px;
    }

    .journey-hero h1 {
      font-size: clamp(3.6rem, 5.4vw, 5.2rem);
    }

    .journey-live {
      max-width: 520px;
      margin-top: 34px;
      padding: 18px;
    }

    .journey-live__copy > strong {
      font-size: 1.4rem;
    }

    .journey-route {
      max-width: 520px;
      margin-top: 30px;
    }

    .journey-route small {
      font-size: 0.74rem;
    }

    .journey-hero__map {
      min-height: 200px;
      margin: 0;
      transform: translateY(-1px);
    }

    .journey-hero__map :global(.route-map-card--hero) {
      border-radius: 0 0 18px 18px;
    }

    .journey-hero__map :global(.route-map-card--hero .route-map-container),
    .journey-hero__map :global(.route-map-card--hero .route-map) {
      height: 200px !important;
      min-height: 200px !important;
    }

    .journey-summary {
      padding: 8px max(3vw, calc((100vw - 1280px) / 2)) 36px;
    }

    .journey-summary__track {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
      overflow: visible;
      border-block: 1px solid var(--journey-line);
    }

    .journey-summary__item {
      min-width: 0;
      min-height: 116px;
      padding: 18px 20px;
      border: 0;
      border-right: 1px solid var(--journey-line);
      border-radius: 0;
      background: transparent;
    }

    .journey-summary__item:last-child {
      border-right: 0;
    }

    .journey-summary__progress {
      margin-top: 16px;
    }
  }

  @media (min-width: 1180px) {
    .journey-hero__frame {
      grid-template-columns: minmax(420px, 0.72fr) minmax(680px, 1.28fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-hero__image,
    .journey-live__dot,
    .journey-route__rail > span {
      animation: none;
    }

    .journey-hero__image {
      transform: none;
    }
  }
</style>
