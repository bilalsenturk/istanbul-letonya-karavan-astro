---
import MainLayout from '../layouts/MainLayout.astro';
import JourneyHero from '../components/JourneyHero.astro';
import RouteMap from '../components/RouteMap.astro';
import { tripData } from '../data/tripData';

const mapStops = tripData.stops.map((stop) => ({ name: stop.name, lat: stop.lat, lng: stop.lng }));
const countryCodes: Record<string, string> = {
  Türkiye: 'TR',
  Bulgaristan: 'BG',
  Sırbistan: 'RS',
  Romanya: 'RO',
  Macaristan: 'HU',
  Slovakya: 'SK',
  Çekya: 'CZ',
  Polonya: 'PL',
  Litvanya: 'LT',
  Letonya: 'LV',
};
const routeCountryCodes = Array.from(new Set(tripData.stops.map((stop) => countryCodes[stop.country]).filter(Boolean)));
const parseDistanceKm = (label: string): number => {
  const matches = label.match(/\d+/g)?.map(Number).filter(Number.isFinite) ?? [];
  if (matches.length >= 2) return Math.round((matches[0] + matches[1]) / 2);
  return matches[0] ?? 0;
};
const routeTimeline = tripData.days.map((day) => ({
  id: day.id,
  slug: day.slug,
  date: day.date,
  from: day.origin,
  to: day.destination,
  distanceLabel: day.distanceKm,
  distanceKm: parseDistanceKm(day.distanceKm),
  duration: day.duration,
  camp: day.camp?.name ?? null,
}));
const travelPhotos = [
  {
    src: '/assets/follow-highway.jpg',
    alt: 'Karavanla otoyolda yolculuk',
  },
  {
    src: '/assets/follow-budapest.jpg',
    alt: 'Budapeşte yolunda karavan',
  },
  {
    src: '/assets/follow-sofia.png',
    alt: 'Sofya şehir içinde karavan',
  },
];
---

<MainLayout
  title="KUZEY"
  description="Leyla'nın Kuzey Yolculuğu."
>
  <div
    class="follow-page"
    data-home-dashboard
    data-total-km={tripData.totalKm}
    data-departure-at={tripData.departureAt}
    data-route-codes={JSON.stringify(routeCountryCodes)}
    data-route-timeline={JSON.stringify(routeTimeline)}
  >
    <JourneyHero routeStops={mapStops} totalKm={tripData.totalKm} />

    <details class="route-timeline-section" data-route-details open aria-label="Rota zaman çizgisi">
      <summary class="route-timeline-head">
        <div>
          <h2>Rota çizgisi</h2>
          <p id="route-timeline-summary">Rota başlamadı</p>
        </div>
        <div class="route-timeline-head__meta">
          <strong id="route-timeline-progress">0 km</strong>
          <span class="route-timeline-toggle" aria-hidden="true"></span>
        </div>
      </summary>
      <div class="route-timeline" data-route-timeline-list>
        {routeTimeline.map((leg, index) => (
          <article
            class="route-leg"
            data-leg-index={index}
            data-leg-distance={leg.distanceKm}
            data-leg-to={leg.to}
          >
            <div class="route-leg__markers" aria-hidden="true">
              <span class="route-leg__dot"></span>
              <span class="route-leg__rail"><span data-leg-fill></span></span>
              <span class="route-leg__dot route-leg__dot--to"></span>
            </div>
            <div class="route-leg__body">
              <div class="route-leg__title">
                <div>
                  <strong>{leg.from} → {leg.to}</strong>
                  <small>{leg.date}</small>
                </div>
                <span class="route-leg__status" data-leg-status>Bekliyor</span>
              </div>
              <dl>
                <div>
                  <dt>Mesafe</dt>
                  <dd>{leg.distanceLabel}</dd>
                </div>
                <div>
                  <dt>Süre</dt>
                  <dd>{leg.duration}</dd>
                </div>
                {leg.camp ? (
                  <div>
                    <dt>Durak</dt>
                    <dd>{leg.camp}</dd>
                  </div>
                ) : null}
              </dl>
              <a class="route-leg__action" href={`/day/${leg.slug}`}>Gün planını aç</a>
            </div>
          </article>
        ))}
      </div>
    </details>

    <section class="follow-map-section" id="harita" aria-label="Canlı harita">
      <div class="follow-section-head">
        <h2>Harita</h2>
      </div>
      <RouteMap
        title="Rota"
        routeStops={mapStops}
        activeFrom="İstanbul"
        activeTo="Riga"
        mode="journey"
        live={true}
        height="460px"
      />
    </section>

    <section class="follow-grid" aria-label="Yol detayları">
      <article class="follow-panel">
        <div class="follow-panel__head">
          <h2>Yol</h2>
        </div>
        <dl class="follow-list">
          <div>
            <dt>Sıradaki</dt>
            <dd id="live-next">-</dd>
          </div>
          <div>
            <dt>Etap</dt>
            <dd id="live-leg-remaining">-</dd>
          </div>
          <div>
            <dt>Hız</dt>
            <dd id="live-speed">-</dd>
          </div>
          <div>
            <dt>Rakım</dt>
            <dd id="live-altitude">-</dd>
          </div>
          <div>
            <dt>Basınç</dt>
            <dd id="live-pressure">-</dd>
          </div>
          <div>
            <dt>Güncelleme</dt>
            <dd id="last-seen">-</dd>
          </div>
        </dl>
      </article>

      <article class="follow-panel">
        <div class="follow-panel__head">
          <h2>Harcama</h2>
        </div>
        <dl class="follow-list">
          <div>
            <dt>Yakıt</dt>
            <dd id="fuel-spend">-</dd>
          </div>
          <div>
            <dt>Toplam</dt>
            <dd id="spend-total-detail">-</dd>
          </div>
          <div>
            <dt>Dizel</dt>
            <dd id="roadfeed-fuel">-</dd>
          </div>
          <div>
            <dt>Rüzgar</dt>
            <dd id="weather-wind">-</dd>
          </div>
          <div>
            <dt>Yağış</dt>
            <dd id="weather-rain">-</dd>
          </div>
          <div>
            <dt>Sınır</dt>
            <dd id="border-note">-</dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="follow-gallery" aria-label="Yoldan kareler">
      <div class="follow-gallery__controls" aria-label="Galeri kontrolleri">
        <button type="button" data-gallery-scroll="-1" aria-label="Önceki fotoğraf" title="Önceki fotoğraf">←</button>
        <button type="button" data-gallery-scroll="1" aria-label="Sonraki fotoğraf" title="Sonraki fotoğraf">→</button>
      </div>
      <div class="follow-gallery__track" data-gallery-track tabindex="0" aria-label="Yol fotoğrafları">
        {travelPhotos.map((photo, index) => (
          <figure class="follow-gallery__item">
            <img src={photo.src} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} />
          </figure>
        ))}
      </div>
    </section>
  </div>
</MainLayout>

<script>
  import { mountHomeDashboard } from '../scripts/homeDashboard';

  mountHomeDashboard();
</script>

<style>
  :global(body) {
    background: #090b0f;
  }

  :global(body::before) {
    display: none;
  }

  :global(.container) {
    width: min(1240px, 94vw);
    padding-top: 0;
  }

  :global(.foot) {
    display: none;
  }

  .follow-page {
    display: grid;
    gap: 18px;
  }

  .follow-hero {
    position: relative;
    min-height: clamp(680px, 90svh, 780px);
    margin: 0 calc(50% - 50vw) 2px;
    overflow: hidden;
    background: #111820;
  }

  .follow-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48% center;
  }

  .follow-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 8, 12, 0.58) 0%, rgba(5, 8, 12, 0.26) 42%, rgba(5, 8, 12, 0.02) 76%),
      linear-gradient(180deg, rgba(5, 8, 12, 0.02) 0%, rgba(5, 8, 12, 0.74) 100%);
  }

  .hero-countdown {
    position: absolute;
    z-index: 2;
    top: 24px;
    right: max(3vw, 24px);
    width: min(480px, 42vw);
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(5, 8, 12, 0.54);
    box-shadow: 0 18px 42px -28px rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .hero-countdown__label {
    display: block;
    margin: 0 0 8px 2px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .hero-countdown__grid span {
    min-width: 0;
    padding: 10px 8px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .hero-countdown__grid strong,
  .hero-countdown__grid small {
    display: block;
  }

  .hero-countdown__grid strong {
    color: #fff;
    font-size: clamp(1.65rem, 3vw, 2.65rem);
    font-weight: 850;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }

  .hero-countdown__grid small {
    margin-top: 5px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.68rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .follow-hero__inner {
    position: relative;
    z-index: 1;
    width: min(1240px, 94vw);
    min-height: clamp(680px, 90svh, 780px);
    margin: 0 auto;
    padding: 24px 0 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }

  .follow-hero__copy {
    max-width: 680px;
    color: #fff;
  }

  .follow-hero h1 {
    margin: 0;
    max-width: 760px;
    color: #fff;
    font-size: 4.7rem;
    line-height: 0.94;
    letter-spacing: 0;
  }

  .hero-route-timeline {
    position: relative;
    max-width: 760px;
    margin-top: 22px;
    padding: 0 7px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .hero-route-timeline::-webkit-scrollbar {
    display: none;
  }

  .hero-route-timeline__rail {
    position: absolute;
    top: 9px;
    left: 16px;
    right: 16px;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.24);
  }

  .hero-route-timeline__rail span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: #38e08a;
    transition: width 500ms ease;
  }

  .hero-route-timeline__track {
    position: relative;
    display: flex;
    min-width: 680px;
    justify-content: space-between;
    gap: 10px;
  }

  .hero-route-stop {
    display: grid;
    min-width: 0;
    justify-items: center;
    gap: 7px;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.72rem;
    font-weight: 750;
    text-align: center;
  }

  .hero-route-stop i {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: #1b222c;
    box-shadow: 0 0 0 4px rgba(5, 8, 12, 0.34);
    transition: background 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
  }

  .hero-route-stop small {
    max-width: 74px;
    overflow-wrap: anywhere;
  }

  .hero-route-stop.is-passed,
  .hero-route-stop.is-active {
    color: #e6f6ed;
  }

  .hero-route-stop.is-passed i,
  .hero-route-stop.is-active i {
    border-color: #38e08a;
    background: #38e08a;
  }

  .hero-route-stop.is-active i {
    box-shadow: 0 0 0 5px rgba(56, 224, 138, 0.22), 0 0 18px rgba(56, 224, 138, 0.62);
  }

  .follow-live-line {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    min-height: 42px;
    margin-top: 22px;
    padding: 0 13px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #fff;
    background: rgba(5, 8, 12, 0.6);
    font-weight: 750;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .follow-live-line__dot {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: #3ee88a;
    box-shadow: 0 0 0 5px rgba(62, 232, 138, 0.18);
  }

  .follow-live-line__dot.is-paused {
    background: #ffbd5a;
    box-shadow: 0 0 0 5px rgba(255, 189, 90, 0.18);
  }

  .follow-stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  .follow-stat,
  .follow-panel {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(10, 14, 19, 0.78);
    box-shadow: 0 18px 42px -28px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .follow-stat {
    min-height: 128px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
  }

  .follow-stat span {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .follow-stat strong {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 1.55rem;
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .follow-stat small {
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.76rem;
    line-height: 1.25;
  }

  .journey-progress {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 13px;
    background: rgba(5, 8, 12, 0.64);
  }

  .journey-progress__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.86rem;
  }

  .journey-progress__meta strong {
    color: #fff;
  }

  .journey-progress__bar {
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
  }

  .journey-progress__bar span {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: #38e08a;
    transition: width 500ms ease;
  }

  .follow-map-section,
  .follow-grid,
  .follow-gallery,
  .route-timeline-section {
    width: min(1240px, 94vw);
    margin: 0 auto;
  }

  .route-timeline-section {
    border: 0;
    padding: 24px 0 2px;
    background: transparent;
  }

  .route-timeline-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
    cursor: pointer;
    list-style: none;
  }

  .route-timeline-head::-webkit-details-marker {
    display: none;
  }

  .route-timeline-head::marker {
    content: "";
    font-size: 0;
  }

  .route-timeline-head::before {
    content: none;
    display: none;
  }

  .route-timeline-head > div {
    min-width: 0;
    flex: 1 1 auto;
  }

  .route-timeline-head h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 2rem;
    letter-spacing: 0;
  }

  .route-timeline-head p {
    margin: 6px 0 0;
    color: #9aa5b4;
    font-size: 0.94rem;
    font-weight: 650;
  }

  .route-timeline-head strong {
    flex: 0 0 auto;
    color: #e6f6ed;
    font-size: 1.25rem;
  }

  .route-timeline-head__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .route-timeline-toggle {
    display: none;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    position: relative;
  }

  .route-timeline-toggle::before,
  .route-timeline-toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 999px;
    background: #dce4ee;
    transform: translate(-50%, -50%);
  }

  .route-timeline-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: opacity 180ms ease;
  }

  .route-timeline-section[open] .route-timeline-toggle::after {
    opacity: 0;
  }

  .route-timeline {
    display: grid;
    gap: 10px;
  }

  .route-leg {
    display: grid;
    grid-template-columns: 152px minmax(0, 1fr);
    gap: 16px;
    min-height: 118px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(10, 14, 19, 0.74);
    box-shadow: 0 18px 42px -32px rgba(0, 0, 0, 0.82);
  }

  .route-leg__markers {
    display: grid;
    grid-template-columns: 18px minmax(72px, 1fr) 18px;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .route-leg__dot {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #252c35;
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: background 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
  }

  .route-leg__rail {
    height: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
  }

  .route-leg__rail span {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: #38e08a;
    transition: width 500ms ease;
  }

  .route-leg__body {
    min-width: 0;
  }

  .route-leg__title {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .route-leg__title strong,
  .route-leg__title small {
    display: block;
  }

  .route-leg__title strong {
    color: #f8fafc;
    font-size: 1.04rem;
    line-height: 1.2;
  }

  .route-leg__title small {
    margin-top: 4px;
    color: #8f9aaa;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .route-leg__status {
    flex: 0 0 auto;
    max-width: 150px;
    padding: 5px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #aab4c3;
    font-size: 0.76rem;
    font-weight: 800;
    text-align: center;
    white-space: nowrap;
  }

  .route-leg dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 14px 0 0;
  }

  .route-leg dl div {
    min-width: 0;
  }

  .route-leg dt {
    color: #7f8b9a;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .route-leg dd {
    margin: 4px 0 0;
    color: #dce4ee;
    font-size: 0.86rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .route-leg__action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    color: #dce4ee;
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .route-leg__action:hover {
    color: #fff;
  }

  .route-leg.is-active {
    border-color: rgba(56, 224, 138, 0.32);
    background: rgba(13, 24, 21, 0.8);
  }

  .route-leg.is-active .route-leg__dot:first-child,
  .route-leg.is-done .route-leg__dot {
    background: #38e08a;
    border-color: rgba(56, 224, 138, 0.9);
    box-shadow: 0 0 0 5px rgba(56, 224, 138, 0.12);
  }

  .route-leg.is-active .route-leg__status {
    background: rgba(56, 224, 138, 0.14);
    color: #b9ffd7;
  }

  .route-leg.is-done .route-leg__status {
    background: rgba(56, 224, 138, 0.18);
    color: #d7ffe6;
  }

  .follow-map-section {
    padding: 24px 0 0;
  }

  .follow-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 12px;
  }

  .follow-section-head h2,
  .follow-panel h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 2rem;
    letter-spacing: 0;
  }

  :global(.follow-map-section .card) {
    padding: 0;
    overflow: hidden;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.11);
    background: rgba(10, 14, 19, 0.78);
    box-shadow: 0 18px 42px -28px rgba(0, 0, 0, 0.85);
  }

  :global(.follow-map-section .card h3) {
    margin: 0;
    padding: 16px 16px 0;
    font-size: 1rem;
    letter-spacing: 0;
  }

  :global(.follow-map-section .map-frame) {
    margin-top: 12px;
    border-radius: 0;
  }

  .follow-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .follow-panel {
    padding: 18px;
  }

  .follow-panel__head {
    margin-bottom: 14px;
  }

  .follow-list {
    display: grid;
    gap: 8px;
    margin: 0;
  }

