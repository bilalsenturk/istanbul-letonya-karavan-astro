{
  "name": "istanbul-letonya-karavan-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:latvian": "node --experimental-strip-types tools/generate-latvian-pack.mjs",
    "check:latvian-pack": "node --experimental-strip-types tools/check-latvian-pack.mjs",
    "check:accounts": "node --experimental-strip-types tools/check-account-domain.mjs",
    "check:account-auth": "node --experimental-strip-types tools/check-account-auth.mjs",
    "check:trip-api": "node --experimental-strip-types tools/check-trip-api.mjs",
    "check:web-sync": "node --experimental-strip-types tools/check-web-app-sync.mjs",
    "check:web-experience": "node --experimental-strip-types tools/check-web-experience.mjs && vitest run tools/web-experience-components.test.ts tools/camera-player.test.ts tools/camp-actions.test.ts",
    "check:web-output": "node --experimental-strip-types tools/check-web-output.mjs",
    "check:travel-content": "node tools/check-travel-content.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.3",
    "@vercel/blob": "^2.6.1",
    "astro": "^7.1.1",
    "jose": "^6.2.4",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.22.0",
    "@types/leaflet": "^1.9.21",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.10"
  }
}
