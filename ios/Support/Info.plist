	<string>Yol fotoğraflarını rota haritasına iğnelemek (foto günlüğü) için fotoğraflara erişilir.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Söylediğin harcamayı yazıya çevirmek için konuşma tanıma kullanılır.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
